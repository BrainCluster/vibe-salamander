<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The VibeSalamander.exe in the main folder of a release. The program and its libraries are in the
    "lib" folder; this small starter runs lib\VibeSalamander.exe with the same arguments and exits.
    It targets .NET Framework 4.8, which every supported Windows has built in, so it is only a few KB.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>VibeSalamander</AssemblyName>
    <RootNamespace>VibeSalamander.Launcher</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <ApplicationIcon>..\VibeSalamander.App\Assets\VibeSalamander.ico</ApplicationIcon>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
