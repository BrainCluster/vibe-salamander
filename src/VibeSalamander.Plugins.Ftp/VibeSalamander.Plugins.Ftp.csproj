<Project Sdk="Microsoft.NET.Sdk">
  <!-- Built-in plugin: FTP, FTPS and SFTP servers in the panels (Open Salamander's FTP Client plugin).
       FluentFTP (MIT) for FTP / FTPS, SSH.NET (MIT) for SFTP. Saved passwords are encrypted for the
       Windows user (DPAPI). No UI framework: windows and dialogs come from the host. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>VibeSalamander.Plugins.Ftp</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="FluentFTP" Version="53.0.1" />
    <PackageReference Include="SSH.NET" Version="2025.1.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\VibeSalamander.Plugins.Abstractions\VibeSalamander.Plugins.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="VibeSalamander.Core.Tests" />
  </ItemGroup>
</Project>
