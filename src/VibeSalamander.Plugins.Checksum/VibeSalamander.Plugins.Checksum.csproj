<Project Sdk="Microsoft.NET.Sdk">
  <!-- Built-in plugin: Open Salamander's Checksum plugin. Calculates CRC32 (SFV), MD5, SHA-1, SHA-256 and
       SHA-512 checksums and verifies checksum files. No UI framework: windows and dialogs come from the host. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>VibeSalamander.Plugins.Checksum</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\VibeSalamander.Plugins.Abstractions\VibeSalamander.Plugins.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="VibeSalamander.Core.Tests" />
  </ItemGroup>
</Project>
