<Project Sdk="Microsoft.NET.Sdk">
  <!-- Built-in plugin: technical and tag details of video, audio and image files, as the MediaInfo app shows them.
       The reading is MediaInfo's own library (MediaInfoLib, MediaArea.net, BSD-2-Clause) through the MediaInfoDLL
       wrapper (BSD-2-Clause); the app copies the library for its processor into lib\MediaInfo. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>VibeSalamander.Plugins.MediaInfo</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\VibeSalamander.Plugins.Abstractions\VibeSalamander.Plugins.Abstractions.csproj" />
    <PackageReference Include="MediaInfoDLL" Version="26.1.0" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="VibeSalamander.Core.Tests" />
  </ItemGroup>
</Project>
