<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="VibeSalamander.Views.TransfersPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:VibeSalamander.ViewModels">

    <UserControl.Resources>
        <DataTemplate x:Key="TransferRowTemplate" x:DataType="vm:TransferItemViewModel">
            <Grid Height="40" ColumnSpacing="10" Padding="2,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" MinWidth="160" />
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <FontIcon Glyph="{x:Bind Glyph}" FontFamily="{StaticResource VibeIconFont}" FontSize="15"
                          VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="320" />
                        <TextBlock Text="{x:Bind Route}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Route}" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind CurrentFile, Mode=OneWay}" FontSize="11" TextTrimming="CharacterEllipsis"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="3">
                    <ProgressBar Maximum="100" Value="{x:Bind Percent, Mode=OneWay}" IsIndeterminate="{x:Bind IsIndeterminate, Mode=OneWay}"
                                 ShowPaused="{x:Bind IsPaused, Mode=OneWay}" ShowError="{x:Bind HasError, Mode=OneWay}" />
                    <Grid>
                        <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" FontSize="11" TextTrimming="CharacterEllipsis"
                                   ToolTipService.ToolTip="{x:Bind StatusText, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind DetailText, Mode=OneWay}" FontSize="11" HorizontalAlignment="Right"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="1">
                    <TextBlock Text="{x:Bind SpeedText, Mode=OneWay}" FontSize="11" HorizontalAlignment="Right" />
                    <TextBlock Text="{x:Bind RemainingText, Mode=OneWay}" FontSize="11" HorizontalAlignment="Right"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <Button Style="{StaticResource VibeToolButtonStyle}" Click="Pause_Click" ToolTipService.ToolTip="Pause"
                            Visibility="{x:Bind PauseVisibility, Mode=OneWay}">
                        <FontIcon Glyph="&#xE769;" FontFamily="{StaticResource VibeIconFont}" FontSize="13" />
                    </Button>
                    <Button Style="{StaticResource VibeToolButtonStyle}" Click="Resume_Click" ToolTipService.ToolTip="Resume"
                            Visibility="{x:Bind ResumeVisibility, Mode=OneWay}">
                        <FontIcon Glyph="&#xE768;" FontFamily="{StaticResource VibeIconFont}" FontSize="13" />
                    </Button>
                    <Button Style="{StaticResource VibeToolButtonStyle}" Click="Cancel_Click" ToolTipService.ToolTip="Cancel"
                            Visibility="{x:Bind CancelVisibility, Mode=OneWay}">
                        <FontIcon Glyph="&#xE711;" FontFamily="{StaticResource VibeIconFont}" FontSize="13" />
                    </Button>
                    <Button Style="{StaticResource VibeToolButtonStyle}" Click="Remove_Click" ToolTipService.ToolTip="Remove from list"
                            Visibility="{x:Bind RemoveVisibility, Mode=OneWay}">
                        <FontIcon Glyph="&#xE74D;" FontFamily="{StaticResource VibeIconFont}" FontSize="13" />
                    </Button>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Border Background="{ThemeResource VibePaneBackgroundBrush}" BorderBrush="{ThemeResource VibePaneBorderBrush}"
            BorderThickness="1" CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- header -->
            <Grid Background="{ThemeResource VibeBarBackgroundBrush}" Padding="8,0,4,0" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE896;" FontFamily="{StaticResource VibeIconFont}" FontSize="13" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="Transfers" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock x:Name="SummaryText" Grid.Column="2" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource VibeHeaderForegroundBrush}" />
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2">
                    <Button x:Name="ClearButton" Style="{StaticResource VibeToolButtonStyle}" Click="Clear_Click"
                            ToolTipService.ToolTip="Remove finished transfers from the list">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE73E;" FontFamily="{StaticResource VibeIconFont}" FontSize="12" />
                            <TextBlock Text="Clear finished" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ClearAllButton" Style="{StaticResource VibeToolButtonStyle}" Click="ClearAll_Click"
                            ToolTipService.ToolTip="Cancel running transfers and empty the list">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE894;" FontFamily="{StaticResource VibeIconFont}" FontSize="12" />
                            <TextBlock Text="Clear all" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="CollapseButton" Style="{StaticResource VibeToolButtonStyle}" Click="Collapse_Click" ToolTipService.ToolTip="Collapse">
                        <FontIcon x:Name="CollapseGlyph" Glyph="&#xE70D;" FontFamily="{StaticResource VibeIconFont}" FontSize="13" />
                    </Button>
                </StackPanel>
            </Grid>

            <ListView x:Name="List" Grid.Row="1" SelectionMode="None" IsItemClickEnabled="False" Padding="0,2"
                      ItemTemplate="{StaticResource TransferRowTemplate}" ItemContainerStyle="{StaticResource VibeListItemStyle}" />
        </Grid>
    </Border>
</UserControl>
