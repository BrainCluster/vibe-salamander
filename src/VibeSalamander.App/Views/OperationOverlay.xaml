<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="VibeSalamander.Views.OperationOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Backdrop" Background="{ThemeResource SmokeFillColorDefaultBrush}">
        <Border Width="580" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24,20" CornerRadius="8"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1">
            <StackPanel Spacing="8">
                <TextBlock x:Name="TitleText" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock x:Name="SourceText" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="TargetText" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <ProgressBar x:Name="FileProgress" Maximum="1" Margin="0,6,0,0" />
                <ProgressBar x:Name="TotalProgress" Maximum="1" IsIndeterminate="True" />
                <Grid>
                    <TextBlock x:Name="DetailsText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="SpeedText" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
                <Button x:Name="CancelButton" Content="Cancel" MinWidth="96" HorizontalAlignment="Right" Margin="0,8,0,0" Click="Cancel_Click" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
