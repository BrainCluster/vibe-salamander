<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="VibeSalamander.Views.CompareWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:VibeSalamander.Views"
    Title="Compare Directories">

    <Grid x:Name="RootGrid" Padding="12,0,12,8" RowSpacing="8" KeyDown="RootGrid_KeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBarArea" Background="Transparent" Margin="0,0,140,0">
            <TextBlock x:Name="TitleBarText" Text="Compare Directories" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>

        <!-- the two folders -->
        <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="LeftText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <FontIcon Grid.Column="1" Glyph="&#xE8AB;" FontFamily="{StaticResource VibeIconFont}" FontSize="14" />
            <TextBlock x:Name="RightText" Grid.Column="2" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <Button x:Name="CompareAgainButton" Grid.Column="3" Click="CompareAgain_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72C;" FontFamily="{StaticResource VibeIconFont}" FontSize="13" />
                    <TextBlock Text="Compare again" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- which differences are listed -->
        <StackPanel x:Name="FilterPanel" Grid.Row="2" Orientation="Horizontal" Spacing="6" />

        <!-- synchronize -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="10">
            <TextBlock Text="Synchronize:" VerticalAlignment="Center" />
            <ComboBox x:Name="DirectionBox" MinWidth="200" SelectionChanged="Direction_SelectionChanged" />
            <CheckBox x:Name="MirrorBox" Content="Mirror (newer files on the other side are overwritten, extra items deleted)" MinWidth="0"
                      Click="Mirror_Click" />
            <Button x:Name="SyncButton" Style="{StaticResource AccentButtonStyle}" Click="Sync_Click" IsEnabled="False">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE895;" FontFamily="{StaticResource VibeIconFont}" FontSize="13" />
                    <TextBlock x:Name="SyncText" Text="Synchronize" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- the differences -->
        <ListView x:Name="Results" Grid.Row="4" SelectionMode="Single" BorderBrush="{ThemeResource VibePaneBorderBrush}" BorderThickness="1"
                  CornerRadius="6" Background="{ThemeResource VibePaneBackgroundBrush}" ItemContainerStyle="{StaticResource VibeListItemStyle}"
                  DoubleTapped="Results_DoubleTapped">
            <ListView.Header>
                <Grid ColumnSpacing="10" Padding="12,4,12,4" Background="{ThemeResource VibeBarBackgroundBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="190" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="Item" FontSize="12" Opacity="0.75" />
                    <TextBlock Grid.Column="2" Text="Left" FontSize="12" Opacity="0.75" />
                    <TextBlock Grid.Column="3" Text="Action" FontSize="12" Opacity="0.75" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="4" Text="Right" FontSize="12" Opacity="0.75" />
                </Grid>
            </ListView.Header>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="views:CompareRow">
                    <Grid ColumnSpacing="10" Height="28">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="190" />
                        </Grid.ColumnDefinitions>
                        <CheckBox IsChecked="{x:Bind IsChecked, Mode=TwoWay}" MinWidth="0" Padding="0" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="{x:Bind Glyph}" FontFamily="{StaticResource VibeIconFont}" FontSize="13" />
                            <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind Folder}" Opacity="0.6" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{x:Bind LeftDetail}" FontSize="12" VerticalAlignment="Center" Opacity="{x:Bind LeftOpacity}" />
                        <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4"
                                    ToolTipService.ToolTip="{x:Bind KindText}">
                            <FontIcon Glyph="{x:Bind ActionGlyph, Mode=OneWay}" FontFamily="{StaticResource VibeIconFont}" FontSize="14"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="{x:Bind ActionText, Mode=OneWay}" FontSize="11" Opacity="0.75" />
                        </StackPanel>
                        <TextBlock Grid.Column="4" Text="{x:Bind RightDetail}" FontSize="12" VerticalAlignment="Center" Opacity="{x:Bind RightOpacity}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Grid Grid.Row="5" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ProgressRing x:Name="Busy" Width="14" Height="14" IsActive="False" />
            <TextBlock x:Name="StatusText" Grid.Column="1" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>
    </Grid>
</Window>
