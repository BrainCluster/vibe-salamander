<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="VibeSalamander.Views.FilePane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:VibeSalamander.ViewModels"
    xmlns:views="using:VibeSalamander.Views">

    <UserControl.Resources>

        <DataTemplate x:Key="FileRowTemplate" x:DataType="vm:FileItemViewModel">
            <Grid Height="{x:Bind RowHeight}" Opacity="{x:Bind ItemOpacity}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="{x:Bind Columns.ExtColumn, Mode=OneWay}" />
                    <ColumnDefinition Width="{x:Bind Columns.SizeColumn, Mode=OneWay}" />
                    <ColumnDefinition Width="{x:Bind Columns.DateColumn, Mode=OneWay}" />
                    <ColumnDefinition Width="{x:Bind Columns.TimeColumn, Mode=OneWay}" />
                    <ColumnDefinition Width="{x:Bind Columns.AttrColumn, Mode=OneWay}" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind Glyph}" FontFamily="{StaticResource VibeIconFont}" FontSize="14"
                          Foreground="{x:Bind GlyphBrush, Mode=OneWay}" Visibility="{x:Bind GlyphVisibility, Mode=OneWay}"
                          HorizontalAlignment="Left" VerticalAlignment="Center" />
                <Image Source="{x:Bind Icon, Mode=OneWay}" Width="16" Height="16"
                       HorizontalAlignment="Left" VerticalAlignment="Center" />
                <TextBlock Tag="NameText" Grid.Column="1" Text="{x:Bind Name}" Foreground="{x:Bind NameBrush, Mode=OneWay}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" HorizontalAlignment="Left"
                           Visibility="{x:Bind NameVisibility, Mode=OneWay}" />
                <TextBlock Tag="NameText" Grid.Column="2" Text="{x:Bind Ext}" Foreground="{x:Bind TextBrush, Mode=OneWay}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="6,0,0,0"
                           Visibility="{x:Bind NameVisibility, Mode=OneWay}" />
                <!-- F2: the name label itself becomes editable (name + extension, like Salamander); created only while renaming -->
                <TextBox x:Name="RenameBox" x:Load="{x:Bind IsRenaming, Mode=OneWay}" Grid.Column="1" Grid.ColumnSpan="2" Tag="RenameBox"
                         Visibility="{x:Bind RenameVisibility, Mode=OneWay}"
                         MinHeight="0" MinWidth="0" Padding="2,0,2,0" Margin="-3,1,4,1" BorderThickness="1"
                         VerticalAlignment="Stretch" VerticalContentAlignment="Center" IsSpellCheckEnabled="False"
                         KeyDown="RenameBox_KeyDown" GotFocus="RenameBox_GotFocus" LostFocus="RenameBox_LostFocus" />
                <TextBlock Grid.Column="3" Text="{x:Bind SizeText, Mode=OneWay}" Foreground="{x:Bind TextBrush, Mode=OneWay}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Grid.Column="4" Text="{x:Bind DateText}" Foreground="{x:Bind TextBrush, Mode=OneWay}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Grid.Column="5" Text="{x:Bind TimeText}" Foreground="{x:Bind TextBrush, Mode=OneWay}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Grid.Column="6" Text="{x:Bind AttrText}" Foreground="{x:Bind TextBrush, Mode=OneWay}"
                           VerticalAlignment="Center" Margin="4,0,0,0" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="DriveRowTemplate" x:DataType="vm:FileItemViewModel">
            <Grid Height="{x:Bind RowHeight}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="112" />
                    <ColumnDefinition Width="84" />
                    <ColumnDefinition Width="84" />
                    <ColumnDefinition Width="150" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind Glyph}" FontFamily="{StaticResource VibeIconFont}" FontSize="14"
                          Visibility="{x:Bind GlyphVisibility, Mode=OneWay}"
                          HorizontalAlignment="Left" VerticalAlignment="Center" />
                <Image Source="{x:Bind Icon, Mode=OneWay}" Width="16" Height="16"
                       HorizontalAlignment="Left" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{x:Bind Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{x:Bind DriveLabel}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="{x:Bind DriveType}" Foreground="{x:Bind TextBrush, Mode=OneWay}" VerticalAlignment="Center" Margin="6,0,0,0" />
                <TextBlock Grid.Column="4" Text="{x:Bind DriveTotal}" Foreground="{x:Bind TextBrush, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Grid.Column="5" Text="{x:Bind DriveFree}" Foreground="{x:Bind TextBrush, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
                <Grid Grid.Column="6" Visibility="{x:Bind UsedVisibility}" ColumnSpacing="8" Margin="4,0,4,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="36" />
                    </Grid.ColumnDefinitions>
                    <ProgressBar Value="{x:Bind UsedPercent}" Maximum="100" Foreground="{x:Bind UsedBrush}"
                                 Background="{ThemeResource VibeUsedTrackBrush}" MinHeight="6" Height="6"
                                 CornerRadius="3" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{x:Bind UsedText}" Foreground="{x:Bind TextBrush, Mode=OneWay}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </DataTemplate>

        <!-- Brief view: names only, in columns that scroll sideways (Alt+1) -->
        <DataTemplate x:Key="BriefTemplate" x:DataType="vm:FileItemViewModel">
            <Grid Height="{x:Bind RowHeight}" Opacity="{x:Bind ItemOpacity}" ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind Glyph}" FontFamily="{StaticResource VibeIconFont}" FontSize="14"
                          Foreground="{x:Bind GlyphBrush, Mode=OneWay}" Visibility="{x:Bind GlyphVisibility, Mode=OneWay}" VerticalAlignment="Center" />
                <Image Source="{x:Bind Icon, Mode=OneWay}" Width="16" Height="16" VerticalAlignment="Center" />
                <TextBlock Tag="NameText" Grid.Column="1" Text="{x:Bind FullName}" Foreground="{x:Bind NameBrush, Mode=OneWay}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" HorizontalAlignment="Left" Visibility="{x:Bind NameVisibility, Mode=OneWay}" />
                <TextBox x:Name="RenameBox" x:Load="{x:Bind IsRenaming, Mode=OneWay}" Grid.Column="1" Tag="RenameBox"
                         MinHeight="0" MinWidth="0" Padding="2,0,2,0" Margin="-3,1,0,1" BorderThickness="1"
                         VerticalContentAlignment="Center" IsSpellCheckEnabled="False"
                         KeyDown="RenameBox_KeyDown" GotFocus="RenameBox_GotFocus" LostFocus="RenameBox_LostFocus" />
            </Grid>
        </DataTemplate>

        <!-- Icons view: large icon, name below (Alt+3) -->
        <DataTemplate x:Key="IconTemplate" x:DataType="vm:FileItemViewModel">
            <Grid Opacity="{x:Bind ItemOpacity}" Padding="2,6,2,2" RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <FontIcon Glyph="{x:Bind Glyph}" FontFamily="{StaticResource VibeIconFont}" FontSize="38"
                          Foreground="{x:Bind GlyphBrush, Mode=OneWay}" Visibility="{x:Bind LargeGlyphVisibility, Mode=OneWay}" />
                <Image Source="{x:Bind LargeIcon, Mode=OneWay}" Width="48" Height="48" Stretch="Uniform" />
                <TextBlock Tag="NameText" Grid.Row="1" Text="{x:Bind FullName}" Foreground="{x:Bind NameBrush, Mode=OneWay}"
                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2" TextAlignment="Center"
                           HorizontalAlignment="Center" Visibility="{x:Bind NameVisibility, Mode=OneWay}" />
                <TextBox x:Name="RenameBox" x:Load="{x:Bind IsRenaming, Mode=OneWay}" Grid.Row="1" Tag="RenameBox"
                         MinHeight="0" MinWidth="0" Padding="2,0,2,0" BorderThickness="1" VerticalAlignment="Top"
                         TextAlignment="Center" IsSpellCheckEnabled="False"
                         KeyDown="RenameBox_KeyDown" GotFocus="RenameBox_GotFocus" LostFocus="RenameBox_LostFocus" />
            </Grid>
        </DataTemplate>

        <!-- Thumbnails view: picture previews (Alt+4) -->
        <DataTemplate x:Key="ThumbnailTemplate" x:DataType="vm:FileItemViewModel">
            <Grid Opacity="{x:Bind ItemOpacity}" Padding="4,6,4,2" RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="{x:Bind ThumbnailRowHeight}" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border CornerRadius="4" Background="{ThemeResource VibeInactivePathBrush}">
                    <Grid>
                        <FontIcon Glyph="{x:Bind Glyph}" FontFamily="{StaticResource VibeIconFont}" FontSize="48"
                                  Foreground="{x:Bind GlyphBrush, Mode=OneWay}" Visibility="{x:Bind LargeGlyphVisibility, Mode=OneWay}" />
                        <Image Source="{x:Bind LargeIcon, Mode=OneWay}" Stretch="Uniform" Margin="4" />
                    </Grid>
                </Border>
                <TextBlock Tag="NameText" Grid.Row="1" Text="{x:Bind FullName}" Foreground="{x:Bind NameBrush, Mode=OneWay}"
                           TextTrimming="CharacterEllipsis" TextAlignment="Center" HorizontalAlignment="Center"
                           Visibility="{x:Bind NameVisibility, Mode=OneWay}" />
                <TextBox x:Name="RenameBox" x:Load="{x:Bind IsRenaming, Mode=OneWay}" Grid.Row="1" Tag="RenameBox"
                         MinHeight="0" MinWidth="0" Padding="2,0,2,0" BorderThickness="1" VerticalAlignment="Top"
                         TextAlignment="Center" IsSpellCheckEnabled="False"
                         KeyDown="RenameBox_KeyDown" GotFocus="RenameBox_GotFocus" LostFocus="RenameBox_LostFocus" />
            </Grid>
        </DataTemplate>

        <!-- Tiles view: icon with name, type and size beside it (Alt+5) -->
        <DataTemplate x:Key="TileTemplate" x:DataType="vm:FileItemViewModel">
            <Grid Opacity="{x:Bind ItemOpacity}" ColumnSpacing="10" Padding="4,4,6,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="{x:Bind Glyph}" FontFamily="{StaticResource VibeIconFont}" FontSize="36"
                          Foreground="{x:Bind GlyphBrush, Mode=OneWay}" Visibility="{x:Bind LargeGlyphVisibility, Mode=OneWay}" />
                <Image Source="{x:Bind LargeIcon, Mode=OneWay}" Width="48" Height="48" Stretch="Uniform" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                    <Grid>
                        <TextBlock Tag="NameText" Text="{x:Bind FullName}" Foreground="{x:Bind NameBrush, Mode=OneWay}" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" Visibility="{x:Bind NameVisibility, Mode=OneWay}" />
                        <TextBox x:Name="RenameBox" x:Load="{x:Bind IsRenaming, Mode=OneWay}" Tag="RenameBox"
                                 MinHeight="0" MinWidth="0" Padding="2,0,2,0" Margin="-3,0,0,0" BorderThickness="1"
                                 IsSpellCheckEnabled="False"
                                 KeyDown="RenameBox_KeyDown" GotFocus="RenameBox_GotFocus" LostFocus="RenameBox_LostFocus" />
                    </Grid>
                    <TextBlock Text="{x:Bind TileType}" Foreground="{x:Bind TextBrush, Mode=OneWay}" FontSize="11" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind TileDetail, Mode=OneWay}" Foreground="{x:Bind TextBrush, Mode=OneWay}" FontSize="11" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <views:FileRowTemplateSelector x:Key="RowTemplateSelector"
                                       FileTemplate="{StaticResource FileRowTemplate}"
                                       DriveTemplate="{StaticResource DriveRowTemplate}"
                                       BriefTemplate="{StaticResource BriefTemplate}"
                                       IconTemplate="{StaticResource IconTemplate}"
                                       ThumbnailTemplate="{StaticResource ThumbnailTemplate}"
                                       TileTemplate="{StaticResource TileTemplate}" />
    </UserControl.Resources>

    <Grid x:Name="RootGrid" Background="{ThemeResource VibePaneBackgroundBrush}" AllowDrop="True"
          DragOver="Root_DragOver" Drop="Root_Drop"
          BorderBrush="{ThemeResource VibePaneBorderBrush}" BorderThickness="1" CornerRadius="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- drive bar -->
        <ScrollViewer x:Name="DriveBar" Grid.Row="0" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                      HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled" Padding="4,3,4,1">
            <StackPanel Orientation="Horizontal" Spacing="1">
                <Button Style="{StaticResource VibeDriveButtonStyle}" Click="ThisPcButton_Click" ToolTipService.ToolTip="This PC">
                    <FontIcon Glyph="&#xE7F4;" FontFamily="{StaticResource VibeIconFont}" FontSize="14" />
                </Button>
                <ItemsControl ItemsSource="{x:Bind ViewModel.VisibleDrives, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:DriveButtonViewModel">
                            <StackPanel Orientation="Horizontal" Spacing="1">
                                <Button Style="{StaticResource VibeDriveButtonStyle}" Click="DriveButton_Click"
                                        ToolTipService.ToolTip="{x:Bind ToolTip}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <Grid Width="16" Height="16">
                                            <FontIcon Glyph="&#xEDA2;" FontFamily="{StaticResource VibeIconFont}" FontSize="13" />
                                            <Image Source="{x:Bind Icon, Mode=OneWay}" Width="16" Height="16" />
                                        </Grid>
                                        <TextBlock Text="{x:Bind Letter}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <!-- Configuration → Change Drive Menu and Drive Bar: separator after this drive -->
                                <Border Width="1" Margin="3,4" Background="{ThemeResource VibePaneBorderBrush}"
                                        Visibility="{x:Bind SeparatorVisibility, Mode=OneWay}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- directory line: Windows 11 style address bar (This PC > drive > folders; click a folder to go there,
             a chevron for its subfolders, the empty area to type a path), quick search, filter, free space;
             accent-filled when this panel is active -->
        <Grid Grid.Row="1" Margin="4,2,4,2" MinHeight="26" CornerRadius="4" PointerPressed="DirectoryLine_PointerPressed">
            <Border Background="{ThemeResource VibeInactivePathBrush}" CornerRadius="4" />
            <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="4"
                    Visibility="{x:Bind VisibleIf(ViewModel.IsActive), Mode=OneWay}" />
            <Grid ColumnSpacing="6" Padding="2,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- drive drop-down (Alt+F1 / Alt+F2): icon of the current drive, click for the drive menu -->
                <Button x:Name="DriveMenuButton" Style="{StaticResource VibeToolButtonStyle}" Padding="5,2,4,2"
                        Click="DriveMenuButton_Click" ToolTipService.ToolTip="Change drive (Alt+F1 / Alt+F2)">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="{x:Bind ViewModel.DriveMenuGlyph, Mode=OneWay}" FontFamily="{StaticResource VibeIconFont}" FontSize="13"
                                  Foreground="{x:Bind PathForeground(ViewModel.IsActive), Mode=OneWay}" VerticalAlignment="Center" />
                        <FontIcon Glyph="&#xE70D;" FontFamily="{StaticResource VibeIconFont}" FontSize="8" VerticalAlignment="Center"
                                  Foreground="{x:Bind PathForeground(ViewModel.IsActive), Mode=OneWay}" />
                    </StackPanel>
                </Button>
                <Grid x:Name="BreadcrumbHost" Grid.Column="1" SizeChanged="BreadcrumbHost_SizeChanged">
                    <StackPanel x:Name="Breadcrumb" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" />
                </Grid>
                <TextBox x:Name="PathEditor" Grid.Column="1" Visibility="Collapsed" MinHeight="0" Padding="6,2"
                         VerticalAlignment="Center" KeyDown="PathEditor_KeyDown" LostFocus="PathEditor_LostFocus" />
                <Border Grid.Column="2" Visibility="{x:Bind VisibleIfText(ViewModel.QuickSearch), Mode=OneWay}"
                        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" CornerRadius="3" Padding="6,0">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE721;" FontFamily="{StaticResource VibeIconFont}" FontSize="11" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.QuickSearch, Mode=OneWay}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Visibility="{x:Bind VisibleIfText(ViewModel.FilterText), Mode=OneWay}"
                        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" CornerRadius="3" Padding="6,0"
                        ToolTipService.ToolTip="Panel filter (Ctrl+F12)">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE71C;" FontFamily="{StaticResource VibeIconFont}" FontSize="11" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.Filter, Mode=OneWay}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <ProgressRing Grid.Column="4" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="14" Height="14"
                              Foreground="{x:Bind PathForeground(ViewModel.IsActive), Mode=OneWay}" />
                <TextBlock Grid.Column="5" Text="{x:Bind ViewModel.FreeSpaceText, Mode=OneWay}"
                           Foreground="{x:Bind PathForeground(ViewModel.IsActive), Mode=OneWay}"
                           VerticalAlignment="Center" Opacity="0.85" />
                <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="0" Margin="0,0,-6,0">
                    <!-- maximize / restore this panel (Configuration → Appearance) -->
                    <Button x:Name="MaximizeButton" Style="{StaticResource VibeToolButtonStyle}" Padding="5,2"
                            Click="MaximizeButton_Click" ToolTipService.ToolTip="Maximize / restore panel (Ctrl+F11)">
                        <FontIcon Glyph="&#xE740;" FontFamily="{StaticResource VibeIconFont}" FontSize="10"
                                  Foreground="{x:Bind PathForeground(ViewModel.IsActive), Mode=OneWay}" />
                    </Button>
                    <!-- recent locations, like the drop-down at the end of Explorer's address bar (Alt+F12) -->
                    <Button x:Name="HistoryButton" Style="{StaticResource VibeToolButtonStyle}" Padding="5,2"
                            Click="HistoryButton_Click" ToolTipService.ToolTip="Working directories (Alt+F12)">
                        <FontIcon Glyph="&#xE70D;" FontFamily="{StaticResource VibeIconFont}" FontSize="10"
                                  Foreground="{x:Bind PathForeground(ViewModel.IsActive), Mode=OneWay}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- header line (files, Detailed view): click to sort, drag the grips to resize, right-click to choose columns -->
        <Grid x:Name="FileHeader" Grid.Row="2" Height="24" Padding="16,0,4,0" Background="Transparent"
              Visibility="{x:Bind HeaderVisibility(ViewModel.EffectiveViewMode, ViewModel.IsThisPc), Mode=OneWay}"
              RightTapped="Header_RightTapped">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="22" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="{x:Bind ViewModel.Columns.ExtColumn, Mode=OneWay}" />
                <ColumnDefinition Width="{x:Bind ViewModel.Columns.SizeColumn, Mode=OneWay}" />
                <ColumnDefinition Width="{x:Bind ViewModel.Columns.DateColumn, Mode=OneWay}" />
                <ColumnDefinition Width="{x:Bind ViewModel.Columns.TimeColumn, Mode=OneWay}" />
                <ColumnDefinition Width="{x:Bind ViewModel.Columns.AttrColumn, Mode=OneWay}" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource VibeHeaderButtonStyle}" Tag="Name" Click="Header_Click" Padding="22,0,6,0">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="Name" />
                    <FontIcon Glyph="{x:Bind SortGlyph(ViewModel.SortMode, ViewModel.SortDescending, 'Name'), Mode=OneWay}" FontFamily="{StaticResource VibeIconFont}" FontSize="9" />
                </StackPanel>
            </Button>
            <Button Grid.Column="2" Style="{StaticResource VibeHeaderButtonStyle}" Tag="Extension" Click="Header_Click"
                    Visibility="{x:Bind ViewModel.Columns.ExtVisibility, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="Ext" />
                    <FontIcon Glyph="{x:Bind SortGlyph(ViewModel.SortMode, ViewModel.SortDescending, 'Extension'), Mode=OneWay}" FontFamily="{StaticResource VibeIconFont}" FontSize="9" />
                </StackPanel>
            </Button>
            <Button Grid.Column="3" Style="{StaticResource VibeHeaderButtonStyle}" Tag="Size" Click="Header_Click" HorizontalContentAlignment="Right"
                    Visibility="{x:Bind ViewModel.Columns.SizeVisibility, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <FontIcon Glyph="{x:Bind SortGlyph(ViewModel.SortMode, ViewModel.SortDescending, 'Size'), Mode=OneWay}" FontFamily="{StaticResource VibeIconFont}" FontSize="9" />
                    <TextBlock Text="Size" />
                </StackPanel>
            </Button>
            <Button Grid.Column="4" Style="{StaticResource VibeHeaderButtonStyle}" Tag="Date" Click="Header_Click" HorizontalContentAlignment="Right"
                    Visibility="{x:Bind ViewModel.Columns.DateVisibility, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <FontIcon Glyph="{x:Bind SortGlyph(ViewModel.SortMode, ViewModel.SortDescending, 'Date'), Mode=OneWay}" FontFamily="{StaticResource VibeIconFont}" FontSize="9" />
                    <TextBlock Text="Date" />
                </StackPanel>
            </Button>
            <Button Grid.Column="5" Style="{StaticResource VibeHeaderButtonStyle}" Tag="Date" Click="Header_Click" HorizontalContentAlignment="Right"
                    Visibility="{x:Bind ViewModel.Columns.TimeVisibility, Mode=OneWay}">
                <TextBlock Text="Time" />
            </Button>
            <Button Grid.Column="6" Style="{StaticResource VibeHeaderButtonStyle}" Tag="Attributes" Click="Header_Click"
                    Visibility="{x:Bind ViewModel.Columns.AttrVisibility, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="Attr" />
                    <FontIcon Glyph="{x:Bind SortGlyph(ViewModel.SortMode, ViewModel.SortDescending, 'Attributes'), Mode=OneWay}" FontFamily="{StaticResource VibeIconFont}" FontSize="9" />
                </StackPanel>
            </Button>
            <!-- resize grips on the left edge of each column (drag; double-click resets the width) -->
            <views:PanelSplitter Grid.Column="2" Tag="Ext" Width="7" Margin="-4,3,0,3" HorizontalAlignment="Left" Background="Transparent"
                                 Visibility="{x:Bind ViewModel.Columns.ExtVisibility, Mode=OneWay}"
                                 PointerPressed="ColumnGrip_PointerPressed" PointerMoved="ColumnGrip_PointerMoved"
                                 PointerReleased="ColumnGrip_PointerReleased" DoubleTapped="ColumnGrip_DoubleTapped" />
            <views:PanelSplitter Grid.Column="3" Tag="Size" Width="7" Margin="-4,3,0,3" HorizontalAlignment="Left" Background="Transparent"
                                 Visibility="{x:Bind ViewModel.Columns.SizeVisibility, Mode=OneWay}"
                                 PointerPressed="ColumnGrip_PointerPressed" PointerMoved="ColumnGrip_PointerMoved"
                                 PointerReleased="ColumnGrip_PointerReleased" DoubleTapped="ColumnGrip_DoubleTapped" />
            <views:PanelSplitter Grid.Column="4" Tag="Date" Width="7" Margin="-4,3,0,3" HorizontalAlignment="Left" Background="Transparent"
                                 Visibility="{x:Bind ViewModel.Columns.DateVisibility, Mode=OneWay}"
                                 PointerPressed="ColumnGrip_PointerPressed" PointerMoved="ColumnGrip_PointerMoved"
                                 PointerReleased="ColumnGrip_PointerReleased" DoubleTapped="ColumnGrip_DoubleTapped" />
            <views:PanelSplitter Grid.Column="5" Tag="Time" Width="7" Margin="-4,3,0,3" HorizontalAlignment="Left" Background="Transparent"
                                 Visibility="{x:Bind ViewModel.Columns.TimeVisibility, Mode=OneWay}"
                                 PointerPressed="ColumnGrip_PointerPressed" PointerMoved="ColumnGrip_PointerMoved"
                                 PointerReleased="ColumnGrip_PointerReleased" DoubleTapped="ColumnGrip_DoubleTapped" />
            <views:PanelSplitter Grid.Column="6" Tag="Attr" Width="7" Margin="-4,3,0,3" HorizontalAlignment="Left" Background="Transparent"
                                 Visibility="{x:Bind ViewModel.Columns.AttrVisibility, Mode=OneWay}"
                                 PointerPressed="ColumnGrip_PointerPressed" PointerMoved="ColumnGrip_PointerMoved"
                                 PointerReleased="ColumnGrip_PointerReleased" DoubleTapped="ColumnGrip_DoubleTapped" />
        </Grid>

        <!-- header line (This PC) -->
        <Grid Grid.Row="2" Height="24" Padding="16,0,4,0"
              Visibility="{x:Bind VisibleIf(ViewModel.IsThisPc), Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="22" />
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="112" />
                <ColumnDefinition Width="84" />
                <ColumnDefinition Width="84" />
                <ColumnDefinition Width="150" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1" Text="Drive" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource VibeHeaderForegroundBrush}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="Label" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource VibeHeaderForegroundBrush}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="3" Text="Type" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource VibeHeaderForegroundBrush}" VerticalAlignment="Center" Margin="6,0,0,0" />
            <TextBlock Grid.Column="4" Text="Total Size" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource VibeHeaderForegroundBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBlock Grid.Column="5" Text="Free Space" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource VibeHeaderForegroundBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBlock Grid.Column="6" Text="Used" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource VibeHeaderForegroundBrush}" VerticalAlignment="Center" Margin="4,0,0,0" />
        </Grid>

        <Border Grid.Row="2" VerticalAlignment="Bottom" Height="1" Background="{ThemeResource VibePaneBorderBrush}" />

        <!-- file list -->
        <ListView x:Name="FileList" Grid.Row="3"
                  ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                  ItemTemplateSelector="{StaticResource RowTemplateSelector}"
                  ItemContainerStyle="{StaticResource VibeListItemStyle}"
                  SelectionMode="Single"
                  IsItemClickEnabled="False"
                  Padding="0,2,0,2"
                  SelectionChanged="List_SelectionChanged"
                  PreviewKeyDown="List_PreviewKeyDown"
                  DoubleTapped="List_DoubleTapped"
                  ContainerContentChanging="List_ContainerContentChanging"
                  SizeChanged="FileList_SizeChanged"
                  GotFocus="List_GotFocus"
                  CharacterReceived="List_CharacterReceived"
                  RightTapped="List_RightTapped"
                  CanDragItems="True"
                  DragItemsStarting="List_DragItemsStarting">
            <ListView.ItemContainerTransitions>
                <TransitionCollection />
            </ListView.ItemContainerTransitions>
        </ListView>

        <!-- mouse rectangle selection (drawn over the list, doesn't take clicks) -->
        <Canvas x:Name="MarqueeLayer" Grid.Row="3" IsHitTestVisible="False">
            <Border x:Name="Marquee" Visibility="Collapsed" BorderThickness="1" CornerRadius="2"
                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}">
                <Rectangle Fill="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.18" />
            </Border>
        </Canvas>

        <!-- information line -->
        <Border x:Name="InfoLine" Grid.Row="4" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource VibePaneBorderBrush}"
                Padding="10,3,10,4">
            <TextBlock Text="{x:Bind ViewModel.InfoText, Mode=OneWay}" TextTrimming="CharacterEllipsis"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Border>
    </Grid>
</UserControl>
