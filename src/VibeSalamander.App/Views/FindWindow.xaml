<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="VibeSalamander.Views.FindWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:VibeSalamander.Views"
    Title="Find Files and Directories">

    <Grid x:Name="RootGrid" Padding="12,0,12,8" RowSpacing="8" KeyDown="RootGrid_KeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleBarText" Grid.Row="0" Text="Find Files and Directories" VerticalAlignment="Center"
                   Style="{StaticResource CaptionTextBlockStyle}" />

        <!-- criteria -->
        <Grid Grid.Row="1" ColumnSpacing="12" RowSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Named:" VerticalAlignment="Center" />
            <TextBox x:Name="NamedBox" Grid.Column="1" Text="*.*" PlaceholderText="*.txt;*.doc|*.bak" />
            <Button x:Name="FindButton" Grid.Column="2" Content="Find" MinWidth="110" Style="{StaticResource AccentButtonStyle}" Click="FindButton_Click" />

            <TextBlock Grid.Row="1" Text="Look in:" VerticalAlignment="Center" />
            <TextBox x:Name="LookInBox" Grid.Row="1" Grid.Column="1" />
            <Button x:Name="FocusButton" Grid.Row="1" Grid.Column="2" Content="Focus in Panel" MinWidth="110" IsEnabled="False" Click="FocusButton_Click" />

            <TextBlock Grid.Row="2" Text="Containing:" VerticalAlignment="Center" />
            <TextBox x:Name="ContainingBox" Grid.Row="2" Grid.Column="1" PlaceholderText="(optional) text inside the files" />

            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="16">
                <CheckBox x:Name="SubdirsBox" Content="Include subdirectories" IsChecked="True" />
                <CheckBox x:Name="DirectoriesBox" Content="Find directories too" IsChecked="True" />
                <CheckBox x:Name="HiddenBox" Content="Hidden and system" IsChecked="True" />
                <CheckBox x:Name="MatchCaseBox" Content="Match case" />
            </StackPanel>
        </Grid>

        <!-- results -->
        <Grid Grid.Row="2" BorderBrush="{ThemeResource VibePaneBorderBrush}" BorderThickness="1" CornerRadius="6"
              Background="{ThemeResource VibePaneBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="26" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Padding="14,0,14,0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="140" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Name" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" Foreground="{ThemeResource VibeHeaderForegroundBrush}" />
                <TextBlock Grid.Column="1" Text="Path" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" Foreground="{ThemeResource VibeHeaderForegroundBrush}" />
                <TextBlock Grid.Column="2" Text="Size" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{ThemeResource VibeHeaderForegroundBrush}" />
                <TextBlock Grid.Column="3" Text="Modified" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" Foreground="{ThemeResource VibeHeaderForegroundBrush}" />
            </Grid>
            <ListView x:Name="Results" Grid.Row="1" SelectionMode="Single" ItemContainerStyle="{StaticResource VibeListItemStyle}"
                      DoubleTapped="Results_DoubleTapped" SelectionChanged="Results_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="views:FindResult">
                        <Grid Height="22" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="140" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="{x:Bind Glyph}" FontFamily="{StaticResource VibeIconFont}" FontSize="13" />
                                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{x:Bind Directory}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Opacity="0.75" />
                            <TextBlock Grid.Column="2" Text="{x:Bind SizeText}" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.75" />
                            <TextBlock Grid.Column="3" Text="{x:Bind DateText}" VerticalAlignment="Center" Opacity="0.75" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- status -->
        <Grid Grid.Row="3" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ProgressRing x:Name="Busy" Width="14" Height="14" IsActive="False" />
            <TextBlock x:Name="StatusText" Grid.Column="1" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>
    </Grid>
</Window>
