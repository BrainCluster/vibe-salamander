<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="VibeSalamander.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Configuration - Vibe Salamander">

    <Grid x:Name="RootGrid">
        <!-- ThemeResource: follow this window's theme (RootGrid.RequestedTheme), set from code-built pages -->
        <Grid.Resources>
            <Style x:Key="SettingsCardStyle" TargetType="Border">
                <Setter Property="Padding" Value="16,10,16,10" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            </Style>
            <Style x:Key="SettingsFrameStyle" TargetType="Border">
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            </Style>
            <Style x:Key="SettingsDividerStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- the whole row drags the window (not only the title's text); room is left for the caption buttons -->
        <Grid x:Name="TitleBarArea" Grid.Row="0" Background="Transparent" Margin="0,0,140,0">
            <TextBlock x:Name="TitleBarText" Margin="16,0,0,0" Text="Configuration" VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>

        <NavigationView x:Name="Nav" Grid.Row="1" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False" IsPaneToggleButtonVisible="False" OpenPaneLength="220"
                        SelectionChanged="Nav_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="General" Tag="General">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Recycle Bin" Tag="RecycleBin">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE74D;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Confirmations" Tag="Confirmations">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE9D5;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemSeparator />
                <NavigationViewItem Content="Panels" Tag="Panels">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8A9;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Views" Tag="Views">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8FD;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Appearance" Tag="Appearance">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE790;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Colors" Tag="Colors">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE2B1;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Main Window" Tag="MainWindow">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE737;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemSeparator />
                <NavigationViewItem Content="Drives" Tag="Drives">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xEDA2;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Change Drive Menu" Tag="ChangeDrive">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8B7;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemSeparator />
                <NavigationViewItem Content="Viewers" Tag="Viewers">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE7B3;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Editors" Tag="Editors">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE70F;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="History" Tag="History">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE81C;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemSeparator />
                <NavigationViewItem Content="Keyboard" Tag="Keyboard">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE765;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Toolbar" Tag="Toolbar">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE90C;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Hot Paths" Tag="HotPaths">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE734;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="User Menu" Tag="UserMenu">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE712;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Plugins" Tag="Plugins">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xEA86;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Backup" Tag="Backup">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE78C;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="About" Tag="About">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE946;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <ScrollViewer x:Name="PageScroller" Padding="28,16,28,24" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                <ContentPresenter x:Name="PageHost" MaxWidth="880" HorizontalAlignment="Left" />
            </ScrollViewer>
        </NavigationView>
    </Grid>
</Window>
