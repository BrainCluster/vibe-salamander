<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="VibePaneBackgroundBrush" Color="#F7FFFFFF" />
            <SolidColorBrush x:Key="VibePaneBorderBrush" Color="#14000000" />
            <SolidColorBrush x:Key="VibeBarBackgroundBrush" Color="#08000000" />
            <SolidColorBrush x:Key="VibeHeaderForegroundBrush" Color="#9E000000" />
            <SolidColorBrush x:Key="VibeKeyCapBackgroundBrush" Color="#0F000000" />
            <SolidColorBrush x:Key="VibeInactivePathBrush" Color="#0A000000" />
            <SolidColorBrush x:Key="VibeUsedTrackBrush" Color="#1A000000" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="VibePaneBackgroundBrush" Color="#4D1C1C1C" />
            <SolidColorBrush x:Key="VibePaneBorderBrush" Color="#19FFFFFF" />
            <SolidColorBrush x:Key="VibeBarBackgroundBrush" Color="#0AFFFFFF" />
            <SolidColorBrush x:Key="VibeHeaderForegroundBrush" Color="#A6FFFFFF" />
            <SolidColorBrush x:Key="VibeKeyCapBackgroundBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="VibeInactivePathBrush" Color="#0FFFFFFF" />
            <SolidColorBrush x:Key="VibeUsedTrackBrush" Color="#26FFFFFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="VibePaneBackgroundBrush" Color="#4D1C1C1C" />
            <SolidColorBrush x:Key="VibePaneBorderBrush" Color="#19FFFFFF" />
            <SolidColorBrush x:Key="VibeBarBackgroundBrush" Color="#0AFFFFFF" />
            <SolidColorBrush x:Key="VibeHeaderForegroundBrush" Color="#A6FFFFFF" />
            <SolidColorBrush x:Key="VibeKeyCapBackgroundBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="VibeInactivePathBrush" Color="#0FFFFFFF" />
            <SolidColorBrush x:Key="VibeUsedTrackBrush" Color="#26FFFFFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="VibePaneBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="VibePaneBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="VibeBarBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="VibeHeaderForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="VibeKeyCapBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="VibeInactivePathBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="VibeUsedTrackBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <FontFamily x:Key="VibeIconFont">Segoe Fluent Icons,Segoe MDL2 Assets</FontFamily>

    <!-- compact icon-only toolbar button -->
    <Style x:Key="VibeToolButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>

    <!-- drive bar button: icon + letter -->
    <Style x:Key="VibeDriveButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="4,1" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- address bar (breadcrumb) segment and chevron -->
    <Style x:Key="VibeBreadcrumbButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="5,1" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- column header button -->
    <Style x:Key="VibeHeaderButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource VibeHeaderForegroundBrush}" />
    </Style>

    <!-- F-key bar button: key cap + label -->
    <Style x:Key="VibeFKeyButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="2,1" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="VibeListItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="6,0,4,0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="4" />
        <!--
            A light row template instead of the ListViewItemPresenter: its pointer-over, pressed and
            selection backgrounds fade in through animations, so the highlight trails behind a quickly
            moving mouse. Here every state is a plain setter and changes in the same frame, like Explorer.
            The brushes are the list's own lightweight-styling keys (color schemes override them).
        -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Grid x:Name="Root" Control.IsTemplateFocusTarget="True" FocusVisualMargin="{TemplateBinding FocusVisualMargin}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Backplate.Background" Value="{ThemeResource ListViewItemBackgroundPointerOver}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Backplate.Background" Value="{ThemeResource ListViewItemBackgroundPressed}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Target="Backplate.Background" Value="{ThemeResource ListViewItemBackgroundSelected}" />
                                        <Setter Target="SelectionIndicator.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PointerOverSelected">
                                    <VisualState.Setters>
                                        <Setter Target="Backplate.Background" Value="{ThemeResource ListViewItemBackgroundSelectedPointerOver}" />
                                        <Setter Target="SelectionIndicator.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PressedSelected">
                                    <VisualState.Setters>
                                        <Setter Target="Backplate.Background" Value="{ThemeResource ListViewItemBackgroundSelectedPressed}" />
                                        <Setter Target="SelectionIndicator.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="DisabledStates">
                                <VisualState x:Name="Enabled" />
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.5" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Border x:Name="Backplate" Margin="4,0" Background="{TemplateBinding Background}"
                                CornerRadius="{TemplateBinding CornerRadius}" />
                        <Border x:Name="SelectionIndicator" Opacity="0" Width="3" Height="16" Margin="4,0,0,0"
                                HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="1.5"
                                Background="{ThemeResource AccentFillColorDefaultBrush}" />
                        <ContentPresenter x:Name="ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          ContentTransitions="{TemplateBinding ContentTransitions}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
