<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>VibeSalamander</RootNamespace>
    <AssemblyName>VibeSalamander</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' != 'ARM64'">win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Unpackaged app: F5 in Visual Studio runs the .exe directly, no MSIX deployment needed. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Assets\VibeSalamander.ico</ApplicationIcon>
    <!-- release builds are precompiled (ReadyToRun): no waiting for the JIT the first time a view or folder is shown -->
    <PublishReadyToRun Condition="'$(Configuration)' == 'Release'">true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <!-- .NET compacts its memory more readily (slightly more work during cleanups, a smaller footprint) -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.*" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VibeSalamander.Core\VibeSalamander.Core.csproj" />
    <ProjectReference Include="..\VibeSalamander.Plugins.Abstractions\VibeSalamander.Plugins.Abstractions.csproj" />
    <!-- built-in plugins -->
    <ProjectReference Include="..\VibeSalamander.Plugins.Archive\VibeSalamander.Plugins.Archive.csproj" />
    <ProjectReference Include="..\VibeSalamander.Plugins.Checksum\VibeSalamander.Plugins.Checksum.csproj" />
    <ProjectReference Include="..\VibeSalamander.Plugins.Ftp\VibeSalamander.Plugins.Ftp.csproj" />
    <ProjectReference Include="..\VibeSalamander.Plugins.DiskMap\VibeSalamander.Plugins.DiskMap.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\VibeSalamander.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\VibeSalamander.png" CopyToOutputDirectory="PreserveNewest" />
    <!-- GPL: the license and the credits go with every copy of the program -->
    <Content Include="..\..\LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\CREDITS.md" Link="CREDITS.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\AUTHORS" Link="AUTHORS.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- translations (Configuration → General → Language) -->
    <Content Include="Strings\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    The built-in editor is Monaco (the editor of Visual Studio Code, MIT). It isn't kept in the repository: the first
    build downloads it from npm (registry.npmjs.org) into Assets\Monaco (ignored by git); Windows' tar unpacks it.
  -->
  <PropertyGroup>
    <MonacoVersion>0.52.2</MonacoVersion>
    <MonacoFolder>$(MSBuildProjectDirectory)\Assets\Monaco</MonacoFolder>
    <MonacoDownload>$(MSBuildProjectDirectory)\obj\monaco-$(MonacoVersion)</MonacoDownload>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="Assets\Editor\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="DownloadMonaco" Condition="!Exists('$(MonacoFolder)\vs\loader.js')">
    <DownloadFile SourceUrl="https://registry.npmjs.org/monaco-editor/-/monaco-editor-$(MonacoVersion).tgz" DestinationFolder="$(MonacoDownload)" Retries="3" />
    <MakeDir Directories="$(MonacoDownload)\package-files" />
    <Exec Command="tar -xzf &quot;$(MonacoDownload)\monaco-editor-$(MonacoVersion).tgz&quot; -C &quot;$(MonacoDownload)\package-files&quot;" />
    <ItemGroup>
      <MonacoFiles Include="$(MonacoDownload)\package-files\package\min\vs\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(MonacoFiles)" DestinationFiles="@(MonacoFiles->'$(MonacoFolder)\vs\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="$(MonacoDownload)\package-files\package\LICENSE" DestinationFolder="$(MonacoFolder)" />
  </Target>
  <Target Name="IncludeMonaco" BeforeTargets="AssignTargetPaths" DependsOnTargets="DownloadMonaco">
    <ItemGroup>
      <Content Include="$(MonacoFolder)\**\*" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
