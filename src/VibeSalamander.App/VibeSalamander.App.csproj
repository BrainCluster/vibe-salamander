<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>VibeSalamander</RootNamespace>
    <AssemblyName>VibeSalamander</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' != 'ARM64'">win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Unpackaged app: F5 in Visual Studio runs the .exe directly, no MSIX deployment needed. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Assets\VibeSalamander.ico</ApplicationIcon>
    <!-- release builds are precompiled (ReadyToRun): no waiting for the JIT the first time a view or folder is shown -->
    <PublishReadyToRun Condition="'$(Configuration)' == 'Release'">true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <!-- .NET compacts its memory more readily (slightly more work during cleanups, a smaller footprint) -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.*" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VibeSalamander.Core\VibeSalamander.Core.csproj" />
    <ProjectReference Include="..\VibeSalamander.Plugins.Abstractions\VibeSalamander.Plugins.Abstractions.csproj" />
    <!-- built-in plugins -->
    <ProjectReference Include="..\VibeSalamander.Plugins.Archive\VibeSalamander.Plugins.Archive.csproj" />
    <ProjectReference Include="..\VibeSalamander.Plugins.Checksum\VibeSalamander.Plugins.Checksum.csproj" />
    <ProjectReference Include="..\VibeSalamander.Plugins.Ftp\VibeSalamander.Plugins.Ftp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\VibeSalamander.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\VibeSalamander.png" CopyToOutputDirectory="PreserveNewest" />
    <!-- GPL: the license and the credits go with every copy of the program -->
    <Content Include="..\..\LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\CREDITS.md" Link="CREDITS.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\AUTHORS" Link="AUTHORS.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- translations (Configuration → General → Language) -->
    <Content Include="Strings\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
